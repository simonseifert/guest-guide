---
import Icon from './Icon.astro';
import { withFallback, type Lang } from '../i18n/ui';
import type { IconName } from './icons';

interface Props {
  href: string;
  title: string;
  desc?: string;
  lang: Lang;
  eyebrow?: Partial<Record<Lang, string>>;
  icon?: IconName;
}
const { href, title, desc, lang, eyebrow: eyebrowProp, icon = 'house' } = Astro.props;
const defaultEyebrow: Partial<Record<Lang, string>> = {
  en: 'Read this first',
  de: 'Bitte zuerst lesen',
  hr: 'Pročitajte prvo',
  it: 'Da leggere per primo',
};
const eyebrow = eyebrowProp ?? defaultEyebrow;
---
<a class="rules-feature" href={href}>
  <span class="icon-tile"><Icon name={icon} size={28} /></span>
  <span class="meta">
    <div class="eyebrow">{withFallback(eyebrow, lang)}</div>
    <h2>{title}</h2>
    {desc && <div class="desc">{desc}</div>}
  </span>
  <Icon name="arrow" size={16} class="arrow" />
</a>
